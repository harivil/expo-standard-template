# PR evidence — screenshots and recordings from .claude/scripts/capture.mjs.
# These attach to the pull request; they are never committed. Binaries in git are forever,
# and a repo two people clone on laptops for years pays for every one of them.
.evidence/

# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects — generated by prebuild. Change app.json or a config plugin instead.
/ios
/android

# Build and test output
build/
coverage/
*.tsbuildinfo

# E2E output. The flows themselves (.maestro/, e2e/) are committed — these are their artifacts.
playwright-report/
test-results/
blob-report/
.playwright/
.maestro/tests/

# Native debug symbols
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Secrets. Never commit one — and if one lands here by accident, rotate it rather than
# only deleting it; git history keeps what you removed.
.env
.env.*
!.env.example

# Editors
.idea/
.DS_Store
*.swp

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*

# Scanner output
semgrep.sarif
*.sarif
.semgrep_logs/

# Local CI receipt from .claude/scripts/ci-local.mjs — a per-machine result, not shared state.
.claude/.ci-local.json

# Per-developer Claude Code overrides — a personal permission allowlist, not team policy.
# Claude Code's own global ignore usually covers this, but a global ignore is per-machine:
# it does not travel with a clone, so without this line the first teammate to clone commits
# their own allowlist into everyone else's repo.
.claude/settings.local.json
