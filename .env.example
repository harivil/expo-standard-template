# Copy to .env.local and fill in. .env* is gitignored except this file.
#
# THE RULE THAT MATTERS: anything prefixed EXPO_PUBLIC_ is inlined into the JavaScript bundle
# at build time. It ships to every device and is readable by anyone who downloads the app.
# It is configuration, never a credential. `.semgrep.yml` fails the build on an EXPO_PUBLIC_
# name that looks like a secret.
#
# A real secret belongs in one of two places:
#   - server-side, behind an API route, never sent to the client;
#   - on the device only after the user authenticates, in expo-secure-store (never
#     AsyncStorage — there is a Semgrep rule for that too).

# ---------------------------------------------------------------- public config
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_ENVIRONMENT=development

# WorkOS AuthKit public client ID (safe to ship: it is an identifier, not a secret).
# WorkOS dashboard → Applications → Client ID.
EXPO_PUBLIC_WORKOS_CLIENT_ID=client_xxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------- build/CI only
# Never committed. Set these as EAS environment variables or GitHub Actions secrets.
#
# EXPO_TOKEN                — EAS CLI auth for CI. Create at expo.dev/settings/access-tokens
# EXPO_APPLE_APP_SPECIFIC_PASSWORD — only if submitting without an ASC API key
